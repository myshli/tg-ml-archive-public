# Telegram API credentials from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session file path without extension (default: ./tg -> tg.session)
# TG_SESSION=/opt/tg-ml-archive/tg

OPENAI_API_KEY=
# TAG_MODEL=gpt-5-mini
# TAG_EFFORT=low
# TAG_WORKERS=8
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=512        # set before the first run; changing it later needs a new DB

# ARCHIVE_DB=/opt/tg-ml-archive/archive.db

# HTTP MCP server (generate with: openssl rand -hex 32)
MCP_TOKEN=
# MCP_HOST=127.0.0.1
# MCP_PORT=8765

# Deploy target and public domain (read by deploy/*.sh; DOMAIN is also needed in the server .env for digest.py)
DEPLOY_HOST=
DOMAIN=
# SITE_URL=https://archive.example.com   # default: https://$DOMAIN
