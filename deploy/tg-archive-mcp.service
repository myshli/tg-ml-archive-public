[Unit]
Description=tg-ml-archive MCP server (public through Caddy, token-protected)
After=network-online.target

# Runs as tgmcp, not tgarchive: tgmcp can reach the database (shared group in
# /var/lib/tg-archive) but not tg.session, which is a full Telegram login, or
# the ingest .env. Its own secrets (MCP_TOKEN, OPENAI_API_KEY) come from a
# root-only file that systemd reads before dropping privileges.
[Service]
User=tgmcp
Group=tgmcp
SupplementaryGroups=tgarchive-db
WorkingDirectory=/opt/tg-ml-archive
EnvironmentFile=/etc/tg-archive-mcp.env
Environment=ARCHIVE_DB=/var/lib/tg-archive/archive.db
ExecStart=/opt/tg-ml-archive/.venv/bin/python mcp_server.py --http
Restart=on-failure
MemoryMax=300M
UMask=0007

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/tg-archive
InaccessiblePaths=-/opt/tg-ml-archive/.env -/opt/tg-ml-archive/tg.session -/root -/home
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
